{
  "name": "fight",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && npx --yes serve dist",
    "check:facts": "node scripts/check-facts.mjs",
    "check:chapters": "node scripts/check-chapters.mjs",
    "check:site": "node scripts/check-site.mjs dist",
    "check:style": "node scripts/check-style.mjs",
    "check": "npm run build && npm run check:facts && npm run check:chapters && npm run check:style && npm run check:site"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "15.0.12",
    "yaml": "2.6.1"
  }
}
